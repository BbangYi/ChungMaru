{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common/agent-response.schema.json",
  "title": "AgentResponse",
  "description": "설명용 Agent 응답",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "description": "agent 동작 모드"
    },
    "model": {
      "type": ["string", "null"],
      "description": "사용한 모델명"
    },
    "reason": {
      "type": ["string", "null"],
      "description": "fallback 또는 예외 사유"
    },
    "response": {
      "type": "string",
      "description": "최종 사용자 안내 문구"
    },
    "sub_agents": {
      "type": ["object", "null"],
      "description": "세부 agent 응답이 있는 경우의 선택 필드",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": ["mode", "response"],
  "additionalProperties": false
}
