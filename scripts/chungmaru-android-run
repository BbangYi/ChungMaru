def read_json_file(path: Path) -> dict[str, object]:
    if not path.exists():
        return {}
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return payload if isinstance(payload, dict) else {}


WORKSPACE_DESKTOP_POLICY = read_json_file(WORKSPACE_DESKTOP_CONFIG)
WORKSPACE_DESKTOP_LAST_STATUS = read_json_file(WORKSPACE_DESKTOP_STATUS)


def policy_string(key: str, default: str = "") -> str:
    value = WORKSPACE_DESKTOP_POLICY.get(key)
    return str(value) if value not in (None, "") else default


